"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-violet-400 dark:text-violet-300\">rocket_launch</span>\n<span class=\"font-['Space_Grotesk'] tracking-[0.1em] uppercase text-2xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400 drop-shadow-[0_0_10px_rgba(124,58,237,0.5)]\">NEBULA_OS</span>\n</div>\n<nav class=\"hidden md:flex gap-10\">\n<a class=\"font-label text-[12px] tracking-[0.2em] text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1\" href=\"#\">TERMINAL</a>\n<a class=\"font-label text-[12px] tracking-[0.2em] text-slate-400 hover:text-violet-300 transition-colors duration-500\" href=\"#\">DISCOVERIES</a>\n<a class=\"font-label text-[12px] tracking-[0.2em] text-slate-400 hover:text-violet-300 transition-colors duration-500\" href=\"#\">SIGNALS</a>\n</nav>\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-violet-400 dark:text-violet-300 cursor-pointer hover:bg-white/5 p-2 rounded-full transition-all\">menu</span>\n</div>\n</header>\n<main class=\"relative z-10 pt-32 px-6 md:px-12 lg:px-24\">\n<!-- Hero Section -->\n<section class=\"min-h-[751px] flex flex-col justify-center items-start relative mb-24\">\n<div class=\"w-full max-w-7xl\">\n<div class=\"flex items-center gap-4 mb-6 opacity-80\">\n<span class=\"h-[1px] w-12 bg-secondary\"></span>\n<span class=\"font-label text-[10px] tracking-[0.4em] uppercase text-secondary\">Aether Interface 4.2</span>\n</div>\n<h1 class=\"font-display text-[12vw] md:text-[8vw] font-black leading-none mb-4 text-glow tracking-tighter\">\n<span class=\"block text-primary\">ELARA</span>\n<span class=\"block text-transparent bg-clip-text bg-gradient-to-r from-secondary to-primary-fixed-dim translate-x-[5%] md:translate-x-[10%]\">VOX</span>\n</h1>\n<div class=\"mt-12 flex flex-col md:flex-row items-start md:items-end gap-8 md:gap-24\">\n<p class=\"max-w-md text-lg md:text-xl text-on-surface-variant leading-relaxed font-light\">\n                        Architecting digital ecosystems at the intersection of <span class=\"text-secondary font-medium\">quantum logic</span> and <span class=\"text-tertiary font-medium\">cinematic aesthetics</span>.\n                    </p>\n<div class=\"flex flex-col gap-4\">\n<div class=\"flex gap-4\">\n<button class=\"px-8 py-4 bg-gradient-to-r from-primary-container to-primary text-on-primary font-label text-xs tracking-widest uppercase font-bold rounded-sm shadow-lg shadow-primary/20 hover:scale-105 transition-transform\">\n                                Initiate Signal\n                            </button>\n<button class=\"px-8 py-4 border border-outline-variant/30 text-on-surface font-label text-xs tracking-widest uppercase hover:border-secondary hover:text-secondary transition-all\">\n                                Protocol Log\n                            </button>\n</div>\n</div>\n</div>\n</div>\n<!-- Absolute decorative elements -->\n<div class=\"absolute right-0 bottom-0 hidden lg:block opacity-20 hover:opacity-50 transition-opacity\">\n<div class=\"w-[300px] h-[300px] border-l border-b border-outline-variant/30 relative\">\n<div class=\"absolute bottom-4 left-4 font-label text-[10px] tracking-widest uppercase\">Coord: 45.2 // 10.9</div>\n<div class=\"absolute -top-1 -right-1 w-2 h-2 bg-secondary\"></div>\n</div>\n</div>\n</section>\n<!-- Featured Discovery Section -->\n<section class=\"mb-32\">\n<div class=\"flex justify-between items-end mb-16\">\n<div>\n<h2 class=\"font-headline text-4xl md:text-5xl font-bold tracking-tight text-on-primary-container mb-4\">Featured Discovery</h2>\n<p class=\"font-label text-xs tracking-[0.3em] uppercase text-outline\">Project Code: NEON_DRIFT</p>\n</div>\n<div class=\"hidden md:block\">\n<span class=\"material-symbols-outlined text-4xl text-secondary opacity-30\">deployed_code</span>\n</div>\n</div>\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-0 group\">\n<!-- Project Image -->\n<div class=\"lg:co