   \"xl\": \"0.5rem\",\n                        \"full\": \"0.75rem\"\n                    },\n                    \"fontFamily\": {\n                        \"headline\": [\"Space Grotesk\"],\n                        \"body\": [\"Be Vietnam Pro\"],\n                        \"label\": [\"Fira Code\"]\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        .glass-panel {\n            background: rgba(25, 32, 43, 0.6);\n            backdrop-filter: blur(20px) saturate(150%);\n            border: 1px solid rgba(149, 141, 161, 0.15);\n        }\n        .nebula-glow {\n            background: radial-gradient(circle at 50% 50%, rgba(124, 58, 237, 0.15) 0%, transparent 70%);\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;\n            vertical-align: middle;\n        }\n        body {\n            background-color: #0c141e;\n            overflow-x: hidden;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body text-on-surface\">\n<!-- TopAppBar -->\n<header class=\"fixed top-0 w-full z-50 flex justify-between items-center px-8 h-20 max-w-[100vw] bg-[#19202b]/60 backdrop-blur-xl shadow-[0_0_40px_rgba(124,58,237,0.08)]\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-violet-400 dark:text-violet-300 text-3xl\">rocket_launch</span>\n<span class=\"text-2xl font-bold tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400 drop-shadow-[0_0_10px_rgba(124,58,237,0.5)] font-headline uppercase\">NEBULA_OS</span>\n</div>\n<nav class=\"hidden md:flex items-center gap-8 font-headline tracking-[0.1em] uppercase text-sm\">\n<a class=\"text-slate-400 hover:text-violet-300 transition-colors duration-500\" href=\"#\">TERMINAL</a>\n<a class=\"text-cyan-400 font-bold border-b-2 border-cyan-400 pb-1\" href=\"#\">PHILOSOPHY</a>\n<a class=\"text-slate-400 hover:text-violet-300 transition-colors duration-500\" href=\"#\">SYSTEMS</a>\n<a class=\"text-slate-400 hover:text-violet-300 transition-colors duration-500\" href=\"#\">SIGNAL_LOG</a>\n</nav>\n<button class=\"text-violet-400 hover:bg-white/5 p-2 rounded-full transition-all\">\n<span class=\"material-symbols-outlined\">menu</span>\n</button>\n</header>\n<main class=\"relative pt-32 pb-24 px-6 md:px-12 lg:px-24\">\n<!-- Nebula Background Elements -->\n<div class=\"fixed inset-0 pointer-events-none z-[-1]\">\n<div class=\"absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-primary/10 rounded-full blur-[120px]\"></div>\n<div class=\"absolute bottom-[10%] left-[-10%] w-[500px] h-[500px] bg-secondary/5 rounded-full blur-[100px]\"></div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full opacity-30\" data-alt=\"Deep space nebula with swirling violet and cyan cosmic dust, ethereal starlight, and atmospheric volumetric lighting textures\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD_Thw1CsSciJLTU4vvsbZUyvbvJvpvmMvmrPYtlx7Jpdn84q78w_wfSgms8-IiWLloc2P6eNPueQiTmgsu2KucSSB3c5uk7VjIvtHDpNW1kidd0XixWPocnBymLMnXPlrs4svvTSwl7fYoNbXZH2WCyPXkGoOaVWoCJ5xKmH7cSG59eWYd8WmgB9aJ7raZty1AzmhtRRSS1bgxZgZsKJ_bAUCCJaiyvgNPjwhwvNIQSQaRwY5SGfGgEEJrRhRSNkNqY4q4HHq6QRUC'); background-size: cover; mix-blend-mode: overlay;\"></div>\n</div>\n<!-- Hero Section: The Mission -->\n<section class=\"max-w-6xl mx-auto mb-32 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n<div class=\"lg:col-span-7 space-y-8\">\n<div class=\"space-y-4\">\n<p class=\"font-label text-secondary tracking-[0.3em] text-xs uppercase\">IDENTIFIER: THE_ARCHITECT</p>\n<h1 class=\"font-headline text-5xl md:text-7xl font-bold leading-tight tracking-tight text-on-surface\">\n                        WEAVING <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary\">DIGITAL VOIDS</span>\n</h1>\n</div>\n<div class=\"space-y-6 text-on-surface-variant text-lg leading-relaxed max-w-2xl\">\n<p>\n                        In the silent expanse between the hardware and the human, I build interfaces that breathe. My philosophy is rooted in \n                        <span class=\"text-on-primary-fixed-variant bg-primary/20 px-2 rounded\">intentional asymmetry</span> and the rejection of traditional constraints.\n                    </p>\n<p>\n                        Technology shouldn't just solve problems; it should create atmospheric resonance. Every line of code is a coordinate in a larger constellation of user experience.\n                    </p>\n</div>\n<div class=\"flex gap-6 pt-4\">\n<button class=\"px-8 py-3 bg-gradient-to-r from-primary-container to-primary rounded-full text-on-primary font-headline font-bold uppercase tracking-widest text-sm hover:scale-105 transition-transform\">\n                        INITIALIZE_LINK\n                    </button>\n<button class=\"px-8 py-3 border border-outline-variant/30 rounded-full font-headline font-medium uppercase tracking-widest text-sm hover:border-secondary hover:text-secondary transition-all\">\n                        VIEW_RECORDS\n                    </button>\n</div>\n</div>\n<div class=\"lg:col-span-5 relative\">\n<div class=\"aspect-square glass-panel rounded-full overflow-hidden p-2 shadow-[0_0_80px_rgba(124,58,237,0.15)] group\">\n<img alt=\"Abstract architectural portrait\" class=\"w-full h-full object-cover rounded-full opacity-80 group-hover:opacity-100 transition-opacity grayscale hover:grayscale-0\" data-alt=\"Cinematic low-key portrait of a digital architect in a dark techwear outfit, illuminated by cold cyan neon light against a dark metallic background\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBhnvK02TYkkL06kwYSDpWLbSsbaMahx5CZ38fkRq9GoN0_M7NInRQibYePdbbXMcdza402nrRE1jxbaUks77tOiqgP4JxKpRGV--OPA06mFJITWgWI21Rkpwsju9z_WCVeB7BRgHFWKqN7fU9UgHACbObnkuqYGHOnJbe38zd1M_SFf-5O5yfmXq4xrFD8-vd11LzBjtdKqUFbpeES9sQ9zdtrAk3gcYgJ0_mAeXS0055hR5_3Bx7cLe6fBQgfv0X5QkyuXjNrcn4I\"/>\n</div>\n<div class=\"absolute -bottom-8 -right-8 glass-panel p-6 rounded-xl border-l-4 border-l-secondary\">\n<p class=\"font-label text-secondary text-[10px] tracking-widest mb-1 uppercase\">CURRENT_COORDINATES</p>\n<p class=\"font-headline font-bold text-xl\">EDGE_STATION_09</p>\n</div>\n</div>\n</section>\n<!-- Philosophy Section: Bento Grid -->\n<section class=\"max-w-6xl mx-auto mb-32\">\n<div class=\"mb-12 flex items-end justify-between border-b border-outline-variant/10 pb-6\">\n<h2 class=\"font-headline text-4xl font-light uppercase tracking-tighter\">TECHNICAL_ETHOS</h2>\n<span class=\"font-label text-outline text-[10px] tracking-widest\">VER: 4.0.1</span>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-4 h-auto md:h-[600px]\">\n<!-- Principle 1 -->\n<div class=\"md:col-span-2 glass-panel p-10 flex flex-col justify-end group hover:bg-white/5 transition-all\">\n<span class=\"material-symbols-outlined text-primary text-4xl mb-6\">dynamic_form</span>\n<h3 class=\"font-headline text-2xl font-bold mb-4 uppercase tracking-wide\">Dynamic Fluidity</h3>\n<p class=\"text-on-surface-variant font-body\">Interfaces that adapt like liquid mercury. My systems prioritize responsive logic that feels organic rather than mechanical.</p>\n</div>\n<!-- Principle 2 -->\n<div class=\"md:col-span-1 glass-panel p-8 flex flex-col items-center justify-center text-center\">\n<div class=\"w-16 h-16 rounded-full border-2 border-dashed border-secondary mb-4 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-secondary\">database</span>\n</div>\n<h4 class=\"font-label text-xs font-bold uppercase mb-2\">Immutable_Data</h4>\n<p class=\"text-[10px] text-outline font-label uppercase tracking-widest\">Security as a default, not a feature.</p>\n</div>\n<!-- Principle 3 -->\n<div class=\"md:col-span-1 glass-panel p-8 relative overflow-hidden group\">\n<div class=\"absolute inset-0 bg-gradient-to-br from-tertiary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\"></div>\n<span class=\"font-label text-[10px] text-tertiary uppercase tracking-widest mb-4 block\">AESTHETIC_REDUCTION</span>\n<p class=\"text-sm font-label leading-relaxed\">\"Perfection is attained not when there is nothing more to add, but when there is nothing left to take away.\"</p>\n</div>\n<!-- Principle 4 -->\n<div class=\"md:col-span-1 glass-panel p-8 flex flex-col justify-between\">\n<h3 class=\"font-headline text-xl font-bold uppercase\">Latent_Design</h3>\n<span class=\"material-symbols-outlined text-primary text-5xl\">visibility_off</span>\n</div>\n<!-- Principle 5 -->\n<div class=\"md:col-span-3 glass-panel p-10 flex flex-col md:flex-row gap-12 items-center\">\n<div class=\"md:w-1/3\">\n<img class=\"rounded-lg opacity-60 border border-outline-variant/20\" data-alt=\"Abstract 3D visualization of complex data structures and neural pathways in glowing violet and cyan lines on a pitch-black background\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCElahSbv7HwtMAtRe7Uz4HemUf7RQaRgGXv81YpN2FKNJOcLPRTGXdd3dHBNbREOXgfBT-9TizA7YcCNiTL5sQaP-kVYDIl6TvBt3JnnOVx_Yr0sy4i2OB7assw2inx0SNpE7xUD-uQFNMU27QPQkkK5I8k5lZ6lia38jpKsfFcyKPZh7TQLDxQFDA6TvGXcvKPiNkPdG7nMLx3YZl3ky1KSJzNacn4IArr1rkZ11DW3SsCbI3ESwvHvchPFl1fmXRD5F7HpI50VK4\"/>\n</div>\n<div class=\"md:w-2/3\">\n<h3 class=\"font-headline text-2xl font-bold mb-4 uppercase\">The Symbiotic Stack</h3>\n<p class=\"text-on-surface-variant mb-6\">Bridging the gap between creative intuition and mathematical precision. I utilize Next-Gen architectures to ensure scalability without sacrificing soul.</p>\n<div class=\"flex gap-4\">\n<span class=\"px-3 py-1 bg-surface-container-highest rounded font-label text-[10px] text-cyan-300\">REACT.SYS</span>\n<span class=\"px-3 py-1 bg-surface-container-highest rounded font-label text-[10px] text-violet-300\">TAILWIND.LIB</span>\n<span class=\"px-3 py-1 bg-surface-container-highest rounded font-label text-[10px] text-amber-300\">RUST.CORE</span>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Skills Section: Floating Constellations -->\n<section class=\"max-w-6xl mx-auto mb-32 relative\">\n<div class=\"absolute -left-24 top-0 -z-10 opacity-20 rotate-12\">\n<span class=\"text-[200px] font-headline font-black text-outline/10 select-none\">SKILLS</span>\n</div>\n<div class=\"text-center mb-16 space-y-4\">\n<h2 class=\"font-headline text-4xl font-bold uppercase tracking-widest\">Skill_Constellations</h2>\n<p class=\"font-label text-outline text-xs uppercase tracking-[0.4em]\">Propulsion &amp; Navigation Systems</p>\n</div>\n<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6\">\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-primary hover:bg-primary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-primary\">terminal</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">ARCH_ENG</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Core</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-secondary hover:bg-secondary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-secondary\">palette</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">UI_FUTURISM</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Expert</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-tertiary hover:bg-tertiary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-tertiary\">animation</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">MOTION_VFX</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Advanced</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-white hover:bg-white/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-on-surface\">api</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">SYSTEM_PROTO</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Core</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-primary hover:bg-primary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-primary\">cloud</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">DEPLOY_OPS</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Advanced</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-secondary hover:bg-secondary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-secondary\">token</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">WEB3_WEBGL</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Specialized</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-tertiary hover:bg-tertiary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-tertiary\">query_stats</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">ALGO_LOGIC</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Core</p>\n</div>\n</div>\n<!-- Skill Capsule -->\n<div class=\"glass-panel p-6 rounded-full flex items-center gap-4 border-l-2 border-l-primary hover:bg-primary/5 transition-all cursor-pointer group\">\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center group-hover:scale-110 transition-transform\">\n<span class=\"material-symbols-outlined text-primary\">architecture</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-sm\">CAD_MODEL</p>\n<p class=\"font-label text-[9px] text-outline uppercase\">Level: Advanced</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Final CTA: Transmission -->\n<section class=\"max-w-4xl mx-auto py-24 text-center glass-panel rounded-3xl relative overflow-hidden\">\n<div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-1 bg-gradient-to-r from-transparent via-secondary to-transparent\"></div>\n<div class=\"relative z-10 space-y-8 p-8 md:p-16\">\n<h2 class=\"font-headline text-4xl font-bold uppercase tracking-[0.2em]\">Ready for Transmission?</h2>\n<p class=\"font-body text-on-surface-variant max-w-xl mx-auto text-lg italic\">\n                    \"The universe is under no obligation to make sense to you. My mission is to ensure the interface does.\"\n                </p>\n<div class=\"flex flex-col md:flex-row justify-center gap-6 pt-4\">\n<div class=\"flex items-center gap-3 glass-panel px-6 py-3 rounded-xl border border-outline-variant/20\">\n<span class=\"material-symbols-outlined text-secondary\">alternate_email</span>\n<span class=\"font-label text-sm uppercase tracking-widest\">nexus@nebula_os.net</span>\n</div>\n<div class=\"flex items-center gap-3 glass-panel px-6 py-3 rounded-xl border border-outline-variant/20\">\n<span class=\"material-symbols-outlined text-primary\">satellite_alt</span>\n<span class=\"font-label text-sm uppercase tracking-widest\">SAT_NET: 0x82...A4</span>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"w-full flex flex-col md:flex-row justify-between items-center px-12 gap-6 pb-12 bg-transparent\">\n<div class=\"flex items-center gap-2\">\n<span class=\"text-violet-400 font-bold font-headline\">NEBULA_OS</span>\n<span class=\"font-label text-[10px] tracking-widest uppercase text-slate-500\">© 2142 CELESTIAL_NEXUS_ESTATE</span>\n</div>\n<div class=\"flex gap-8\">\n<a class=\"font-label text-[10px] tracking-widest uppercase text-slate-500 hover:text-amber-400 transition-all hover:tracking-[0.3em]\" href=\"#\">TERMINAL</a>\n<a class=\"font-label text-[10px] tracking-widest uppercase text-cyan-300 hover:text-amber-400 transition-all hover:tracking-[0.3em]\" href=\"#\">COORDINATES</a>\n<a class=\"font-label text-[10px] tracking-widest uppercase text-slate-500 hover:text-amber-400 transition-all hover:tracking-[0.3em]\" href=\"#\">SIGNAL_LOG</a>\n</div>\n<div class=\"flex gap-4\">\n<span class=\"material-symbols-outlined text-slate-600 text-sm\">wifi_tethering</span>\n<span class=\"material-symbols-outlined text-slate-600 text-sm\">security</span>\n<span class=\"material-symbols-outlined text-slate-600 text-sm\">emergency_home</span>\n</div>\n</footer>\n</body></html>"
