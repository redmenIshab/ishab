rid grid-cols-1 md:grid-cols-12 gap-6\">\n<!-- Project Card 1: Large Featured -->\n<div class=\"md:col-span-8 group\">\n<article class=\"glass-card rounded-xl overflow-hidden transition-all duration-500 h-full flex flex-col\">\n<div class=\"relative h-[400px] overflow-hidden\">\n<img alt=\"Nebula Preview\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" data-alt=\"Stunning nebula cloud in deep space with vibrant purples and cyans swirling around bright star clusters\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCHbAGCxy3mX3hxmieeGzotXfhBnadyUbRa9jJ7jQ4Z2S5kO-zCq1RRho7vesfx4XGZnUz8YxD1G3WDff3zFD3bVadc24ebiia1l9Hr4C_bmCr5-Ft37DFfrhBwEoieFcIane6d8Kl7hUj2JZx85VRDQikhiWZzYZ1OskNQiVWDVn0W_8BVDfkb2r75Uc-zeb09PoE09c2acGAh2XV1_-ASnLXH4vq6iV3zUEJZ7J48vJnvt7C6zouw4paOQirg644C6bRGDQ13rXJV\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-container via-transparent to-transparent opacity-60\"></div>\n<div class=\"absolute top-6 right-6\">\n<span class=\"bg-primary/20 backdrop-blur-md px-4 py-2 rounded-full font-label text-[10px] text-primary tracking-widest uppercase border border-primary/20\">LIVE_NODE</span>\n</div>\n</div>\n<div class=\"p-8 flex-grow\">\n<div class=\"flex justify-between items-start mb-4\">\n<h3 class=\"text-3xl font-headline font-bold text-primary-fixed-dim\">Event_Horizon_OS</h3>\n<span class=\"font-label text-outline text-xs\">2142.08</span>\n</div>\n<p class=\"text-on-surface-variant mb-8 line-clamp-2 max-w-xl\">\n                                A decentralized operating system for celestial resource management, featuring real-time orbital synchronization and neural-link telemetry.\n                            </p>\n<div class=\"flex flex-wrap gap-3\">\n<span class=\"px-3 py-1 bg-surface-container-high rounded text-[11px] font-label text-secondary tracking-wider uppercase border border-outline-variant/20\">RUST</span>\n<span class=\"px-3 py-1 bg-surface-container-high rounded text-[11px] font-label text-secondary tracking-wider uppercase border border-outline-variant/20\">WASM</span>\n<span class=\"px-3 py-1 bg-surface-container-high rounded text-[11px] font-label text-secondary tracking-wider uppercase border border-outline-variant/20\">QUIC</span>\n</div>\n</div>\n</article>\n</div>\n<!-- Project Card 2: Medium Vertical -->\n<div class=\"md:col-span-4 group\">\n<article class=\"glass-card rounded-xl overflow-hidden transition-all duration-500 h-full flex flex-col\">\n<div class=\"relative h-[250px] overflow-hidden\">\n<img alt=\"Solar Flare\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-alt=\"Close up of a supernova explosion with fiery gold and orange gases dissipating into a dark void\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDUmxeKV_GcGHrGR09VHvZuuLShEFvHT0KSui80-Xt_rL-vVkGmYQUPXiH-sOIFkP4rx3_RZDYsGHo5XE9oDAbtJ-e3QbeWpvzzBCtcrqmNvzvryJuufJeyIBq1meEloUQ43-Fa1b25EX7tVBBIZTu-gBrCSQPzGEHst1tCBFGqjVggnxyRKsApwiKNNJCOCQPSn2VGWvVzuZ9AUWbuFMdk90PBwG2-yRElFy4Bb6n0JgnMAEd7z5hBLmMQGNxWkgTgJVcB010vxFoI\"/>\n</div>\n<div class=\"p-6\">\n<h3 class=\"text-xl font-headline font-bold text-on-background mb-3\">Solar_Flare_Engine</h3>\n<p class=\"text-on-surface-variant text-sm mb-6\">High-frequency trading bot optimized for low-latency galactic markets.</p>\n<div class=\"flex flex-wrap gap-2 mb-8\">\n<span class=\"px-2 py-1 bg-surface-container-high rounded text-[10px] font-label text-tertiary tracking-wider uppercase\">C++</span>\n<span class=\"px-2 py-1 bg-surface-container-high rounded text-[10px] font-label text-tertiary tracking-wider uppercase\">PYTHON</span>\n</div>\n<a class=\"inline-flex items-center gap-2 text-secondary font-label text-xs tracking-[0.2em] group/link\" href=\"#\">\n                                READ_LOGS \n                                <span class=\"material-symbols-outlined text-sm transition-transform group-hover/link:translate-x-1\" data-icon=\"arrow_forward\">arrow_forward</span>\n</a>\n</div>\n</article>\n</div>\n<!-- Project Card 3: Grid Item -->\n<div class=\"md:col-span-4 group\">\n<article class=\"glass-card rounded-xl overflow-hidden transition-all duration-500 h-full flex flex-col\">\n<div class=\"p-8\">\n<div class=\"w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6 border border-primary/20\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"hub\">hub</span>\n</div>\n<h3 class=\"text-xl font-headline font-bold text-on-background mb-3\">Nexus_Sync</h3>\n<p class=\"text-on-surface-variant text-sm mb-6\">Encrypted communication protocol for cross-quadrant data packets using quantum entanglement simulation.</p>\n<div class=\"mt-auto flex flex-wrap gap-2\">\n<span class=\"px-2 py-1 bg-surface-container-high rounded text-[10px] font-label text-outline tracking-wider uppercase\">GO</span>\n<span class=\"px-2 py-1 bg-surface-container-high rounded text-[10px] font-label text-outline tracking-wider uppercase\">GRPC</span>\n</div>\n</div>\n</article>\n</div>\n<!-- Project Card 4: Grid Item -->\n<div class=\"md:col-span-4 group\">\n<article class=\"glass-card rounded-xl overflow-hidden transition-all duration-500 h-full flex flex-col\">\n<div class=\"relative h-48 overflow-hidden\">\n<img alt=\"Sync Node\" class=\"w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700\" data-alt=\"Symmetrical cosmic energy field with geometric light patterns floating in an obsidian vacuum\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuB4u2JRyv52dbPrKIZ-7nUEAu0b9Z4NkxeQSqb1hLFvJOeoSoNyQgs9uF4ioOl8MACPsABcGSvP6-Z-I5Ayonh4Sgs2ELNSh4_2-ETUTPJDqEwSeunAkL7QYi8uBRSbb8ifnEk0Fg6B3lCdf9NmJurtE2N7GHvDZKXt-wW4LDeO31_b2wxfXIrUE52a2p-stM2dmq4qGvU4PSezTr0ZmuqA5DOQsROgHH8skBdZx-vdzwyggjvuaB3F21GOsk-nRXmSFeU4q3Les8rN\"/>\n</div>\n<div class=\"p-6\">\n<h3 class=\"text-xl font-headline font-bold text-on-background mb-3\">Void_Mapper</h3>\n<p class=\"text-on-surface-variant text-sm\">Automated surveying of uncharted star systems using computer vision and LIDAR telemetry.</p>\n</div>\n</article>\n</div>\n<!-- Project Card 5: Horizontal Wide -->\n<div class=\"md:col-span-4 group\">\n<article class=\"glass-card rounded-xl p-8 transition-all duration-500 h-full border-l-4 border-l-tertiary\">\n<span class=\"font-label text-tertiary text-[10px] tracking-[0.3em] mb-4 block\">CLASSIFIED_ACCESS</span>\n<h3 class=\"text-2xl font-headline font-bold text-on-background mb-4 uppercase\">Singularity_UI</h3>\n<p class=\"text-on-surface-variant text-sm mb-8\">An experimental component library designed for high-contrast visibility in low-gravity flight decks.</p>\n<div class=\"flex items-center gap-4\">\n<div class=\"flex -space-x-2\">\n<div class=\"w-8 h-8 rounded-full border border-surface bg-primary/40\"></div>\n<div class=\"w-8 h-8 rounded-full border border-surface bg-secondary/40\"></div>\n<div class=\"w-8 h-8 rounded-full border border-surface bg-tertiary/40\"></div>\n</div>\n<span class=\"text-xs font-label text-outline\">v0.9.2-ALPHA</span>\n</div>\n</article>\n</div>\n<!-- Project Card 6: Small Highlight -->\n<div class=\"md:col-span-12 group mt-6\">\n<div class=\"relative glass-card rounded-xl p-12 flex flex-col md:flex-row items-center justify-between gap-12 overflow-hidden\">\n<!-- Background Texture -->\n<div class=\"absolute inset-0 opacity-10 pointer-events-none\" style=\"background-image: radial-gradient(circle at 2px 2px, #958da1 1px, transparent 0); background-size: 32px 32px;\"></div>\n<div class=\"relative z-10 text-center md:text-left\">\n<h2 class=\"text-3xl font-headline font-bold text-on-background mb-2\">INITIATE_NEW_MISSION?</h2>\n<p class=\"text-outline-variant font-label text-sm uppercase tracking-widest\">Awaiting command input from the terminal...</p>\n</div>\n<div class=\"relative z-10\">\n<button class=\"px-10 py-4 bg-gradient-to-r from-primary-container to-inverse-primary text-on-primary font-headline font-bold tracking-widest rounded-full hover:shadow-[0_0_30px_rgba(124,58,237,0.4)] transition-all transform hover:scale-105 active:scale-95\">\n                                TRANSMIT_SIGNAL\n                            </button>\n</div>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"w-full flex flex-col md:flex-row justify-between items-center px-12 gap-6 pb-12 bg-transparent\">\n<div class=\"flex items-center gap-2\">\n<span class=\"text-violet-400 font-bold font-headline uppercase\">NEBULA_OS</span>\n<span class=\"w-2 h-2 rounded-full bg-secondary shadow-[0_0_8px_rgba(93,230,255,0.8)]\"></span>\n</div>\n<div class=\"font-['Fira_Code'] text-[10px] tracking-widest uppercase text-slate-500\">\n            © 2142 CELESTIAL_NEXUS_ESTATE\n        </div>\n<div class=\"flex gap-8 font-['Fira_Code'] text-[10px] tracking-widest uppercase\">\n<a class=\"text-slate-500 hover:text-amber-400 transition-colors duration-700 hover:tracking-[0.3em]\" href=\"#\">TERMINAL</a>\n<a class=\"text-cyan-300 hover:text-amber-400 transition-colors duration-700 hover:tracking-[0.3em]\" href=\"#\">COORDINATES</a>\n<a class=\"text-slate-500 hover:text-amber-400 transition-colors duration-700 hover:tracking-[0.3em]\" href=\"#\">SIGNAL_LOG</a>\n</div>\n</footer>\n<!-- Custom Nebula Tracker (Visual Decoration) -->\n<div class=\"fixed bottom-10 left-10 w-32 h-32 bg-secondary nebula-glow rounded-full mix-blend-screen pointer-events-none opacity-20 drift-animation-slow\"></div>\n<div class=\"fixed top-1/4 right-0 w-64 h-64 bg-tertiary-container nebula-glow rounded-full mix-blend-screen pointer-events-none opacity-10\"></div>\n</body></html>"
